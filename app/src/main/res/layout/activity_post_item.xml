<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/cf_background"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PostItemActivity">

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:layout_marginStart="@dimen/space_8"
            android:layout_marginTop="@dimen/space_8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_close"
            android:src="@drawable/ic_close"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/cf_ink" />

        <!-- Judul berubah per langkah: "Item Category & Status", "Details & Photo Upload", "Location & Confirmation" -->
        <TextView
            android:id="@+id/tv_post_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_4"
            android:textAppearance="@style/TextAppearance.CampusFind.TitleSmall"
            app:layout_constraintBottom_toBottomOf="@id/btn_close"
            app:layout_constraintEnd_toStartOf="@id/tv_post_badge"
            app:layout_constraintStart_toEndOf="@id/btn_close"
            app:layout_constraintTop_toTopOf="@id/btn_close"
            tools:text="Post Item Step 1: Item Category &amp; Status" />

        <TextView
            android:id="@+id/tv_post_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/screen_padding"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/cf_lavender_100"
            android:drawablePadding="@dimen/space_4"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="@dimen/space_4"
            android:text="@string/post_badge"
            android:textAppearance="@style/TextAppearance.CampusFind.Label"
            android:textColor="@color/cf_navy_900"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/ic_dot"
            app:drawableTint="@color/cf_navy_900"
            app:layout_constraintBottom_toBottomOf="@id/btn_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_close" />

        <!-- Progress 3 segmen: warnai lewat kode (selesai = cf_found_bg, aktif = cf_navy_700, belum = cf_lavender_100) -->
        <TextView
            android:id="@+id/tv_step_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_8"
            android:textAppearance="@style/TextAppearance.CampusFind.TitleSmall"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_close"
            tools:text="Step 1 of 3" />

        <LinearLayout
            android:id="@+id/step_progress"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_step_label">

            <View android:id="@+id/step_1" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@drawable/bg_pill" android:backgroundTint="@color/cf_navy_700" />
            <Space android:layout_width="@dimen/space_8" android:layout_height="0dp" />
            <View android:id="@+id/step_2" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@drawable/bg_pill" android:backgroundTint="@color/cf_lavender_100" />
            <Space android:layout_width="@dimen/space_8" android:layout_height="0dp" />
            <View android:id="@+id/step_3" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@drawable/bg_pill" android:backgroundTint="@color/cf_lavender_100" />
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vp_post"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_12"
            app:layout_constraintBottom_toTopOf="@id/footer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/step_progress" />

        <LinearLayout
            android:id="@+id/footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/cf_background"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Sembunyikan (gone) di langkah 1 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_back"
                    style="@style/Widget.CampusFind.Button.Light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_12"
                    android:text="@string/post_back"
                    android:visibility="gone"
                    app:icon="@drawable/ic_arrow_back"
                    app:iconGravity="textStart"
                    tools:visibility="visible" />

                <!-- Label: "Next: Photo Upload" / "Next: Location" / "Post Item Now" -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_next"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/post_next_photo"
                    app:icon="@drawable/ic_arrow_forward" />
            </LinearLayout>

            <!-- Hanya tampil di langkah 3 -->
            <TextView
                android:id="@+id/tv_footer_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:drawablePadding="@dimen/space_4"
                android:gravity="center"
                android:text="@string/post_visible_note"
                android:textAppearance="@style/TextAppearance.CampusFind.Caption"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_shield"
                app:drawableTint="@color/cf_success"
                tools:visibility="visible" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_post"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:indeterminate="true"
                android:visibility="gone" />
        </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>