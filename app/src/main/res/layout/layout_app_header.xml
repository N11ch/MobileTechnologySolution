<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="@dimen/space_8">

        <FrameLayout
            android:id="@+id/header_logo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_logo_tile"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo_mark" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.CampusFind.Title"
            app:layout_constraintBottom_toTopOf="@id/tv_header_subtitle"
            app:layout_constraintEnd_toStartOf="@id/btn_header_notifications"
            app:layout_constraintStart_toEndOf="@id/header_logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tv_header_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:text="@string/header_subtitle_default"
            android:textAppearance="@style/TextAppearance.CampusFind.Caption"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_header_notifications"
            app:layout_constraintStart_toEndOf="@id/header_logo"
            app:layout_constraintTop_toBottomOf="@id/tv_header_title" />

        <ImageButton
            android:id="@+id/btn_header_notifications"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_notifications"
            android:src="@drawable/ic_notifications"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_header_profile"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/cf_ink" />

        <ImageButton
            android:id="@+id/btn_header_profile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/cf_navy_900"
            android:contentDescription="@string/cd_profile"
            android:src="@drawable/ic_person"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/cf_on_dark" />
</androidx.constraintlayout.widget.ConstraintLayout>