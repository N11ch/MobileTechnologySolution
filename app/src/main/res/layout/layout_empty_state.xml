<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_32">

        <ImageView
            android:id="@+id/iv_empty"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/cf_lavender_100"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_20"
            android:src="@drawable/ic_search"
            app:tint="@color/cf_navy_700" />

        <TextView
            android:id="@+id/tv_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/empty_title"
            android:textAppearance="@style/TextAppearance.CampusFind.TitleSmall" />

        <TextView
            android:id="@+id/tv_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center"
            android:text="@string/empty_message"
            android:textAppearance="@style/TextAppearance.CampusFind.BodySmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_empty_action"
            style="@style/Widget.CampusFind.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/empty_action"
            android:visibility="gone"
            tools:visibility="visible" />

</LinearLayout>