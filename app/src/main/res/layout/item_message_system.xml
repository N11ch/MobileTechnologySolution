<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingVertical="@dimen/space_8">

    <TextView
        android:id="@+id/tv_system_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_chat_system"
        android:drawablePadding="@dimen/space_8"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingVertical="@dimen/space_8"
        android:textAppearance="@style/TextAppearance.CampusFind.Label"
        android:textColor="@color/cf_navy_900"
        android:textSize="12sp"
        app:drawableStartCompat="@drawable/ic_check_circle"
        app:drawableTint="@color/cf_success"
        tools:text="Item status updated to Found · Today 14:20" />
</FrameLayout>
