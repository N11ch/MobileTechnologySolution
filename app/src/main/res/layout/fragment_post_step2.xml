<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/space_16"
    tools:context=".PostStep2Fragment">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/post_upload_title"
                    android:textAppearance="@style/TextAppearance.CampusFind.TitleSmall" />

                <TextView
                    android:id="@+id/tv_step_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/cf_lavender_100"
                    android:paddingHorizontal="@dimen/space_12"
                    android:paddingVertical="@dimen/space_4"
                    android:text="@string/post_step_2_of_3"
                    android:textAppearance="@style/TextAppearance.CampusFind.Caption"
                    android:textColor="@color/cf_navy_700" />
            </FrameLayout>

            <!-- Kartu "Tap to add photos" -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CampusFind.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_rounded_12"
                        android:backgroundTint="@color/cf_blue_100"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/space_16"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/cf_navy_700" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/post_tap_to_add"
                        android:textAppearance="@style/TextAppearance.CampusFind.TitleSmall" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:gravity="center"
                        android:text="@string/post_tap_to_add_sub"
                        android:textAppearance="@style/TextAppearance.CampusFind.BodySmall" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_camera"
                            style="@style/Widget.CampusFind.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_8"
                            android:layout_weight="1"
                            android:text="@string/post_camera"
                            app:icon="@drawable/ic_camera"
                            app:iconGravity="textStart" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_gallery"
                            style="@style/Widget.CampusFind.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:layout_weight="1"
                            android:text="@string/post_gallery"
                            app:icon="@drawable/ic_photo_library"
                            app:iconGravity="textStart" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/post_uploaded_photos"
                    android:textAppearance="@style/TextAppearance.CampusFind.BodySmall" />

                <TextView
                    android:id="@+id/tv_photo_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:textAppearance="@style/TextAppearance.CampusFind.Label"
                    android:textColor="@color/cf_navy_700"
                    android:textSize="12sp"
                    tools:text="1 / 3 attached" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="horizontal">

                <include android:id="@+id/slot_1" layout="@layout/item_photo_slot"
                    android:layout_width="0dp" android:layout_height="@dimen/photo_slot_size"
                    android:layout_weight="1" />
                <Space android:layout_width="@dimen/space_8" android:layout_height="0dp" />
                <include android:id="@+id/slot_2" layout="@layout/item_photo_slot"
                    android:layout_width="0dp" android:layout_height="@dimen/photo_slot_size"
                    android:layout_weight="1" />
                <Space android:layout_width="@dimen/space_8" android:layout_height="0dp" />
                <include android:id="@+id/slot_3" layout="@layout/item_photo_slot"
                    android:layout_width="0dp" android:layout_height="@dimen/photo_slot_size"
                    android:layout_weight="1" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CampusFind.Card.Soft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                app:cardBackgroundColor="@color/cf_lavender_200">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_12">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/cf_found_bg"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/space_8"
                        android:src="@drawable/ic_info"
                        app:tint="@color/cf_found_text" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/post_photo_tip"
                        android:textAppearance="@style/TextAppearance.CampusFind.BodySmall"
                        android:textColor="@color/cf_ink" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
