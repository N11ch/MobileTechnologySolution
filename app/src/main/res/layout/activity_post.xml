<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:elevation="16dp"
    app:behavior_hideable="true"
    app:behavior_peekHeight="0dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
    tools:context=".PostActivity">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#CBD5E1" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Buat Laporan Barang"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold" />
    <!-- Pilihan Jenis Laporan: Lost / Found -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggle_report_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:checkedButton="@id/btn_type_lost"
        app:selectionRequired="true"
        app:singleSelection="true">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_type_lost"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Barang Hilang (Lost)"
            android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_type_found"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Menemukan (Found)"
            android:textAllCaps="false" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <!-- Area Upload Foto Barang -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_upload_photo"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#F8FAFC"
        app:cardCornerRadius="12dp"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_post_photo_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Preview Foto Barang"
                android:scaleType="centerCrop"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/layout_upload_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Kamera"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#4F46E5" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ketuk untuk Unggah Foto Barang"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Nama Barang (cth: Tumbler Corkcicle Hitam)">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_post_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Lokasi Kampus dan Titik Spesifik">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_post_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_submit_post"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:text="Publikasikan Laporan"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:backgroundTint="#4F46E5"
        app:cornerRadius="12dp" />
</LinearLayout>